#!/bin/sh
set -eu

# Re-run when the tracked Fish plugin manifest changes:
# fish_plugins hash: {{ include "dot_config/private_fish/fish_plugins" | sha256sum }}

if ! command -v fish >/dev/null 2>&1; then
  echo "skip: fish is not installed; not installing Fisher plugins"
  exit 0
fi

if ! command -v curl >/dev/null 2>&1; then
  echo "skip: curl is not installed; not bootstrapping Fisher"
  exit 0
fi

if ! fish -c '
if not type -q fisher
    curl -sL https://raw.githubusercontent.com/jorgebucaran/fisher/main/functions/fisher.fish | source
end

fisher update
'; then
  echo "warning: Fisher plugin update failed; continuing chezmoi apply" >&2
  exit 0
fi
